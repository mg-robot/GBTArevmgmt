<?xml version="1.0" encoding="UTF-8" ?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description
  >Launched from the Update Price quick action on a Pricing_Matrix__c record. Sets ExpirationDate__c on the current record (end of day before the new effective date) and creates a new record carrying all classification fields forward with the updated price and EffectiveDate__c.</description>
    <environments>Default</environments>
    <interviewLabel
  >Pricing Matrix - Update Price {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Pricing Matrix - Update Price</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <formulas>
        <name>formula_ExpirationDateTime</name>
        <dataType>DateTime</dataType>
        <expression
    >DATETIMEVALUE(TEXT({!input_NewEffectiveDate} - 1) &amp; " 23:59:59")</expression>
    </formulas>
    <formulas>
        <name>formula_NewEffectiveDateTime</name>
        <dataType>DateTime</dataType>
        <expression
    >DATETIMEVALUE(TEXT({!input_NewEffectiveDate}) &amp; " 00:00:00")</expression>
    </formulas>
    <formulas>
        <name>formula_ExpirationDateDisplay</name>
        <dataType>String</dataType>
        <expression>TEXT({!input_NewEffectiveDate} - 1)</expression>
    </formulas>
    <recordCreates>
        <name>Create_New_Record</name>
        <label>Create New Pricing Matrix Record</label>
        <locationX>182</locationX>
        <locationY>480</locationY>
        <connector>
            <targetReference>Screen_Success</targetReference>
        </connector>
        <inputAssignments>
            <field>Name</field>
            <value>
                <elementReference>Get_Current_Record.Name</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Primary_Type__c</field>
            <value>
                <elementReference
        >Get_Current_Record.Primary_Type__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Subtype__c</field>
            <value>
                <elementReference
        >Get_Current_Record.Subtype__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Region__c</field>
            <value>
                <elementReference
        >Get_Current_Record.Region__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Action__c</field>
            <value>
                <elementReference
        >Get_Current_Record.Action__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>AdjustmentType__c</field>
            <value>
                <elementReference
        >Get_Current_Record.AdjustmentType__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>IsActive__c</field>
            <value>
                <elementReference
        >Get_Current_Record.IsActive__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Product2Id__c</field>
            <value>
                <elementReference
        >Get_Current_Record.Product2Id__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Pricebook2Id__c</field>
            <value>
                <elementReference
        >Get_Current_Record.Pricebook2Id__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>EffectiveDate__c</field>
            <value>
                <elementReference
        >formula_NewEffectiveDateTime</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>SalesPrice__c</field>
            <value>
                <elementReference>input_NewSalesPrice</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Floor_Price__c</field>
            <value>
                <elementReference>input_NewFloorPrice</elementReference>
            </value>
        </inputAssignments>
        <object>Pricing_Matrix__c</object>
    </recordCreates>
    <recordLookups>
        <name>Get_Current_Record</name>
        <label>Get Current Pricing Matrix Record</label>
        <locationX>182</locationX>
        <locationY>120</locationY>
        <assignNullValuesIfNoRecordsFound
    >false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Screen_Enter_New_Price</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Pricing_Matrix__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Current_Record</name>
        <label>Set Expiration on Current Record</label>
        <locationX>182</locationX>
        <locationY>360</locationY>
        <connector>
            <targetReference>Create_New_Record</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>ExpirationDate__c</field>
            <value>
                <elementReference>formula_ExpirationDateTime</elementReference>
            </value>
        </inputAssignments>
        <object>Pricing_Matrix__c</object>
    </recordUpdates>
    <runInMode>SystemModeWithSharing</runInMode>
    <screens>
        <name>Screen_Enter_New_Price</name>
        <label>Enter New Price</label>
        <locationX>182</locationX>
        <locationY>240</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Update_Current_Record</targetReference>
        </connector>
        <fields>
            <name>disp_Context</name>
            <fieldText
      >&lt;p&gt;&lt;strong&gt;{!Get_Current_Record.Name}&lt;/strong&gt;&lt;/p&gt;&lt;p style=&quot;color:#444;margin-top:0.25rem&quot;&gt;{!Get_Current_Record.Primary_Type__c} / {!Get_Current_Record.Region__c} / {!Get_Current_Record.Action__c}&lt;/p&gt;&lt;p&gt;Current Price: &lt;strong&gt;${!Get_Current_Record.SalesPrice__c}&lt;/strong&gt; &amp;mdash; Effective: {!Get_Current_Record.EffectiveDate__c}&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <fields>
            <name>disp_Instructions</name>
            <fieldText
      >&lt;p style=&quot;background:#fff8e1;border-left:3px solid #f59e0b;padding:0.5rem 0.75rem;border-radius:2px;color:#78350f&quot;&gt;The current pricing record will be set to expire the day before the new effective date you enter below.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <fields>
            <name>input_NewEffectiveDate</name>
            <dataType>Date</dataType>
            <fieldText>New Effective Date</fieldText>
            <fieldType>InputField</fieldType>
            <helpText
      >The date the new price takes effect. The current record will be automatically expired the day before.</helpText>
            <isRequired>true</isRequired>
        </fields>
        <fields>
            <name>input_NewSalesPrice</name>
            <dataType>Number</dataType>
            <defaultValue>
                <elementReference
        >Get_Current_Record.SalesPrice__c</elementReference>
            </defaultValue>
            <fieldText>New Price</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
            <scale>2</scale>
        </fields>
        <fields>
            <name>input_NewFloorPrice</name>
            <dataType>Number</dataType>
            <defaultValue>
                <elementReference
        >Get_Current_Record.Floor_Price__c</elementReference>
            </defaultValue>
            <fieldText>Floor Price</fieldText>
            <fieldType>InputField</fieldType>
            <helpText
      >Minimum net price after promotions. Pre-filled with the current value — update only if it is also changing.</helpText>
            <isRequired>false</isRequired>
            <scale>2</scale>
        </fields>
        <nextOrFinishButtonLabel>Update Price</nextOrFinishButtonLabel>
        <showFooter>true</showFooter>
        <showHeader>false</showHeader>
    </screens>
    <screens>
        <name>Screen_Success</name>
        <label>Pricing Updated</label>
        <locationX>182</locationX>
        <locationY>600</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>disp_Success</name>
            <fieldText
      >&lt;p style=&quot;color:#166534;font-weight:600&quot;&gt;Price updated successfully.&lt;/p&gt;&lt;p style=&quot;margin-top:0.5rem&quot;&gt;A new pricing matrix record has been created effective &lt;strong&gt;{!input_NewEffectiveDate}&lt;/strong&gt; with a price of &lt;strong&gt;${!input_NewSalesPrice}&lt;/strong&gt;.&lt;/p&gt;&lt;p&gt;This record has been set to expire on &lt;strong&gt;{!formula_ExpirationDateDisplay}&lt;/strong&gt;.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <nextOrFinishButtonLabel>Done</nextOrFinishButtonLabel>
        <showFooter>true</showFooter>
        <showHeader>false</showHeader>
    </screens>
    <start>
        <locationX>182</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Current_Record</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
